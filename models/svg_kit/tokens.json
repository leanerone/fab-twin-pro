{
  "version": "1.0",
  "updated": "2026-10-29",
  "note": "FabTwin 2D 机台 SVG 统一设计令牌。色值取自现有 oxe-drm-topview.svg / amat_metsput.svg / podopener-2200.svg 的实际用量，保证新机型与存量机型视觉一致。Python 与 JS 共用同一份。",

  "canvas": {
    "default_viewbox": "0 0 1080 840",
    "font_family": "Arial, 'Microsoft YaHei', sans-serif"
  },

  "stroke": {
    "default_color": "#3a4250",
    "default_width": 2.2,
    "thin_width": 1.0,
    "heavy_width": 3.0,
    "linecap": "round",
    "linejoin": "round"
  },

  "metal": {
    "light": "#cbd5e1",
    "mid": "#94a3b8",
    "dark": "#334155",
    "panel": "#39414e",
    "edge_light": "#eef3fa",
    "edge_dark": "#59647a",
    "deep": "#0d1420",
    "bolt": "#64748b"
  },

  "state": {
    "run": "#22c55e",
    "alarm": "#dc2626",
    "idle": "#fde047",
    "unload": "#fde047",
    "done": "#ca8a04",
    "off": "#64748b"
  },

  "slot": {
    "empty": "#334155",
    "waiting": "#94a3b8",
    "processing": "#22c55e",
    "done": "#fde047"
  },

  "text": {
    "primary": "#0d1420",
    "secondary": "#64748b",
    "inverse": "#ffffff",
    "title_size": 16,
    "label_size": 11,
    "hint_size": 9
  },

  "wafer": {
    "gradient_id": "rainbowGrad",
    "pattern_id": "waferPattern",
    "shade_id": "waferShade",
    "stops": [
      ["0%", "#ff5f6d"],
      ["18%", "#ff9f43"],
      ["35%", "#f7d154"],
      ["50%", "#4ade80"],
      ["65%", "#22d3ee"],
      ["80%", "#3b82f6"],
      ["100%", "#a855f7"]
    ]
  },

  "tower": {
    "lamp_run": "#22c55e",
    "lamp_alarm": "#dc2626",
    "lamp_idle": "#fde047",
    "lamp_off": "#475569",
    "body": "#334155",
    "width": 22,
    "lamp_height": 16
  },

  "cassette": {
    "default_slots": 25,
    "slot_pitch": 1.75,
    "body_fill": "#39414e",
    "shell_fill": "#cbd5e1"
  },

  "port": {
    "body_fill": "#cbd5e1",
    "inner_fill": "#0d1420",
    "door_fill": "#334155",
    "width": 120,
    "height": 90
  }
}
