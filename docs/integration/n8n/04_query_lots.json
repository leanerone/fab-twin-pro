{
  "name": "4. 查询Lot信息 (Oracle)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lots",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "lots-webhook"
    },
    {
      "parameters": {
        "url": "http://localhost:8010/lots",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "headers": {
            "Authorization": "Bearer fabtwin-db-proxy-secret"
          }
        }
      },
      "name": "Query DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst lots = data.lots || [];\nlet text = '';\nif (lots.length === 0) {\n  text = '未找到Lot记录';\n} else {\n  text = lots.map((l, i) => `${i+1}. Lot: ${l.lot_id || ''} 机台: ${l.machine_id || ''} 状态: ${l.status || ''} 数量: ${l.wafer_qty || ''}`).join('\\n');\n}\nreturn { json: { ...data, summary: text, count: lots.length } };"
      },
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Query DB", "type": "main", "index": 0 }]] },
    "Query DB": { "main": [[{ "node": "Format", "type": "main", "index": 0 }]] },
    "Format": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  }
}
