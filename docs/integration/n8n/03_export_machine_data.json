    {
      "parameters": {
      "jsCode": "// 合并所有数据生成报表\nconst machines = $('获取机台列表').item;\nconst alarms = $('获取告警数据').item;\nconst lots = $('获取 Lot 数据').item;\n\nreturn {\n  json: {\n    answer: `📊 设备数据导出完成\\n\\n- 机台总数：${machines.length || 0} 台\\n- 告警总数：${alarms.length || 0} 条\\n- Lot 总数：${lots.length || 0} 批\\n\\n数据已准备好，可下载 CSV 报表。`,\n    data: {\n      machines: machines,\n      alarms: alarms,\n      lots: lots\n    },\n    workflow: 'export_machine_data',\n    status: 'success'\n  }\n};\n",
      "options": {}
    },
