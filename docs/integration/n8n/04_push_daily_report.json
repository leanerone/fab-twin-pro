      "id": "http-2",
      "name": "获取告警汇总",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 450]
    },
    {
      "parameters": {
      "jsCode": "// 生成日报内容\nconst yieldStats = $('获取产量统计').item || {};\nconst alarms = $('获取告警汇总').item || [];\nconst reportDate = $('解析请求参数').first().json.report_date;\n\nconst criticalCount = alarms.filter(a => a.level === 'critical').length;\nconst warningCount = alarms.filter(a => a.level === 'warning').length;\n\nconst reportText = `\n📋 产线日报 - ${reportDate}\n\n【产量概览】\n• Lot 总数：${yieldStats.total_lots || 0} 批\n• 完成率：${yieldStats.completion_rate || 0}%\n• 晶圆总数：${yieldStats.total_wafers || 0} 片\n\n【告警统计】\n• 严重告警：${criticalCount} 条\n• 警告：${warningCount} 条\n• 总计：${alarms.length} 条\n\n【重点关注】\n${criticalCount > 0 ? '⚠️ 存在严重告警，请立即处理！' : '✅ 无严重告警，运行平稳'}\n\n---\n由 FabTwin Pro 自动生成\n`;\n\nreturn {\n  json: {\n    answer: reportText,\n    data: {\n      report_date: reportDate,\n      yield_stats: yieldStats,\n      alarms: alarms\n    },\n    workflow: 'push_daily_report',\n    status: 'success'\n  }\n};\n",
      "options": {}
    },
      "id": "code-1",
      "name": "生成日报内容",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    },
