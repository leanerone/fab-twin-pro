              "value": "={{ $json.machine_id }}"
            },
            {
              "name": "limit",
              "value": "=10"
            }
          ]
        },
        "options": {}
      },
      "id": "http-1",
      "name": "获取最新告警",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.length }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "larger"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "是否有告警",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
      "jsCode": "const setNode = $('解析请求参数').first().json;\nconst alarms = $('获取最新告警').first().json || [];\n\nreturn {\n  json: {\n    machine_id: setNode.machine_id,\n    alarm_count: alarms.length,\n    priority: setNode.priority,\n    work_order_id: 'WO-' + Date.now(),\n    content: `【故障工单自动生成】\\n\\n机台：${setNode.machine_id}\\n告警数：${alarms.length} 条\\n优先级：${setNode.priority}\\n创建人：AI 助手\\n\\n---\\n请尽快处理！`\n  }\n};\n",
      "options": {}
    },
      "id": "code-1",
      "name": "生成工单内容",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 200]
    },
    {
      "parameters": {
      "respondWith": "json",
      "responseBody": "={\n  \"answer\": \"✅ 故障工单已生成！\\n\\n机台：\" + $json.machine_id + \"\\n工单号：\" + $json.work_order_id + \"\\n优先级：\" + $json.priority + \"\\n\\n工单内容已同步推送至运维组。\",\n  \"workflow\": \"generate_work_order\",\n  \"status\": \"success\"\n}",
      "options": {}
    },
      "id": "respond-1",
      "name": "返回结果",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"answer\": \"⚠️ 当前机台无活动告警，无需生成工单。\",\n  \"workflow\": \"generate_work_order\",\n  \"status\": \"skipped\"\n}",
        "options": {}
      },
      "id": "respond-2",
      "name": "返回无告警",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1130, 450]
    }
  ],
