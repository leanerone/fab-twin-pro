{
  "name": "2. 查询机台状态 (Oracle)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "status",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "status-webhook"
    },
    {
      "parameters": {
        "url": "http://localhost:8010/status",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "headers": {
            "Authorization": "Bearer fabtwin-db-proxy-secret"
          }
        }
      },
      "name": "Query DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst m = data.machine;\nlet text = '';\nif (!m) {\n  text = '未找到该机台';\n} else {\n  text = `机台: ${m.id || ''}\\n型号: ${m.model || ''}\\n状态: ${m.status || ''}\\n当前Lot: ${m.current_lot_id || '无'}`;\n}\nreturn { json: { ...data, summary: text } };"
      },
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Query DB", "type": "main", "index": 0 }]] },
    "Query DB": { "main": [[{ "node": "Format", "type": "main", "index": 0 }]] },
    "Format": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  }
}
