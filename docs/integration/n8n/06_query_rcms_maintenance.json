{
  "name": "6. 查询RCMS维修记录 (Informix)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rcms-maintenance",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "rcms-webhook"
    },
    {
      "parameters": {
        "url": "http://localhost:8010/rcms-maintenance",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "headers": {
            "Authorization": "Bearer fabtwin-db-proxy-secret"
          }
        }
      },
      "name": "Query DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nif (data.error) {\n  return { json: { ...data, summary: '查询失败: ' + data.error } };\n}\nconst records = data.records || [];\nlet text = '';\nif (records.length === 0) {\n  text = '未找到维修记录';\n} else {\n  text = records.map((r, i) => `${i+1}. ${r.pm_date || ''} ${r.pm_type || ''} 维修人: ${r.technician || ''} ${r.description || ''}`).join('\\n');\n}\nreturn { json: { ...data, summary: text, count: records.length } };"
      },
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Query DB", "type": "main", "index": 0 }]] },
    "Query DB": { "main": [[{ "node": "Format", "type": "main", "index": 0 }]] },
    "Format": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  }
}
